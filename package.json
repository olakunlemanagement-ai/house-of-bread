{
  "name": "house-of-bread",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:validate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/validate-content.mts",
    "contrast": "node scripts/check-contrast.mjs",
    "loops:build": "node scripts/loops/process-loops.mjs",
    "loops:verify": "node scripts/loops/verify-white.mjs",
    "loops:sample": "node scripts/loops/sample-extremes.mjs",
    "loops:seams": "node scripts/loops/check-seams.mjs",
    "images:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/images/build-slots.mjs"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
