# Copy to .env.local for local development. Never commit real values.
# All of these are server only. None may carry the NEXT_PUBLIC_ prefix.

# Newsletter (Kit API v4). Without KIT_API_KEY and KIT_FORM_ID the signup
# forms stay in their disabled "opens soon" state.
KIT_API_KEY=
KIT_FORM_ID=

# Tag ids. Optional: a missing tag id skips that tag.
KIT_TAG_LIVE_NOTIFY=
KIT_TAG_SOURCE_FOOTER=
KIT_TAG_SOURCE_SUBSCRIBE_PAGE=
KIT_TAG_SOURCE_LIVE_NOTIFY=
KIT_TAG_SOURCE_PLAN_PAGE=
# Academy waitlist: signups from /subscribe?source=academy-waitlist, linked
# from the Academy page.
KIT_TAG_SOURCE_ACADEMY_WAITLIST=

# Home's teaching block. The ministry's YouTube channel id (starts with UC, 24 characters),
# used to fetch its public video feed at build time, revalidated
# hourly. Teachings reads both channels from lib/site-config.ts. The id
# is public (it is in the channel URL), not a secret.
YOUTUBE_CHANNEL_ID=

# Teachings (/media). Optional. With a YouTube Data API v3 key, "Explore
# series" lists every playlist on the teaching channels and each teaching
# shows its duration. Without it, series come from seriesPlaylistIds in
# lib/site-config.ts and durations are hidden. Server only: restrict the key
# to the YouTube Data API v3 in Google Cloud. See docs/MEDIA-FEED.md.
YOUTUBE_API_KEY=

# Anonymous questions (/ask), sent through the Resend REST API. Without all
# three the question form stays in its disabled "opens soon" state.
# RESEND_FROM must be on a domain verified in Resend (SPF and DKIM).
RESEND_API_KEY=
RESEND_FROM=
QUESTIONS_TO_EMAIL=
